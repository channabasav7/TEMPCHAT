{
  "hosting": {
    "public": "build/web",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self' 'wasm-unsafe-eval' blob: data:; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' 'unsafe-inline' https: http: blob:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' blob: data: https:; connect-src 'self' https: http: wss: ws: blob: data:; worker-src 'self' blob:;"
          },
          {
            "key": "Cross-Origin-Opener-Policy",
            "value": "same-origin-allow-popups"
          }
        ]
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "tempchat-1cd4f",
          "appId": "1:200277215305:android:dac086c4481aa030bd1798",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "tempchat-1cd4f",
          "configurations": {
            "android": "1:200277215305:android:dac086c4481aa030bd1798",
            "ios": "1:200277215305:ios:dac5b41530c81e0bbd1798",
            "web": "1:200277215305:web:b20bfb1d5b515a83bd1798"
          }
        }
      }
    }
  }
}
